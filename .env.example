# Copy to .env and edit. Every variable is optional.

# Port the load balancer listens on.
LB_PORT=8000

# Comma-separated backend URLs. Leave unset to run the three built-in
# demo backends on ports 9001-9003.
# LB_BACKENDS=http://localhost:9001,http://localhost:9002

# How often to health check each backend, and how long to wait for a reply.
# The timeout must be shorter than the interval.
LB_HEALTH_INTERVAL=2s
LB_HEALTH_TIMEOUT=1s